{
  "name": "kick-tv-personal",
  "version": "0.1.0",
  "description": "Cliente personal de Kick para TizenBrew y Tizen 3.0",
  "private": true,
  "packageType": "app",
  "appName": "Kick TV",
  "appPath": "app/tv.html",
  "keys": [
    "ChannelUp",
    "ChannelDown",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "MediaPlay",
    "MediaPause",
    "MediaPlayPause",
    "MediaStop"
  ],
  "files": [
    "app"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "start": "node scripts/serve.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "acorn": "^8.14.0",
    "lucide-static": "^1.61.0"
  },
  "dependencies": {
    "m3u8-parser": "^7.2.0"
  }
}
